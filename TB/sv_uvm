#!/usr/bin/csh

source /apps/design_environment.csh
setenv UVM_HOME /home/morris/uvm-1.2
vcs -sverilog -timescale=1ns/1ns +vpi +define+UVM_OBJECT_MUST_HAVE_CONSTRUCTOR +incdir+${UVM_HOME}/src ${UVM_HOME}/src/uvm.sv ${UVM_HOME}/src/dpi/uvm_dpi.cc -CFLAGS -DVCS $argv
if ($status != 0) exit $status

set TESTS = (pcs_test pcs_test_min pcs_test_max pcs_test_all_zeros pcs_test_all_ones \
             pcs_test_walking_ones pcs_test_walking_zeros pcs_test_alt_55_aa \
             pcs_test_same_byte pcs_test_btb)

foreach t ($TESTS)
  ./simv +UVM_TESTNAME=$t +ntb_random_seed_automatic -l sim_$t.log
  set nerr = `grep -c -E '^UVM_(ERROR|FATAL) @' sim_$t.log`
  if ($nerr == 0) then
    echo "PASS  $t"
  else
    echo "FAIL  $t  ($nerr errors)"
  endif
end
